{
  "manifest_version": 3,
  "name": "AI Phishing Detector",
  "version": "1.0",
  "description": "Detect phishing websites using AI.",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://phishshield-ai-psjv.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}